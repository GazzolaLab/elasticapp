# Usage
# Docker must be run as root on your machine. This Dockerfile
# supports the following images.
# different images in this Dockerfile.
# 1. `dev`
#
#   cd $ELASTICA_HOME
#   bash containers/build.sh --target dev <optional arguments>
# 
# 2. `ci` (Depends on dev, has more configurations for testing)
#
#   cd $ELASTICA_HOME
#   bash containers/build.sh --target ci <optional arguments>

ARG DOXYGEN_VERSION=1_9_6
ARG HDF5_SERIES=1.12
ARG HDF5_PATCH=2
ARG PARALLEL_ARG=2

FROM ubuntu:22.04 as dev
LABEL maintainer="Tejaswin Parthasarathy <tp5@illinois.edu>"
LABEL description="Elastica++ development environment"

ARG DOXYGEN_VERSION
ARG HDF5_SERIES
ARG HDF5_PATCH
ARG PARALLEL_ARG

# Setup user account
ARG uid=1000
ARG gid=1000
RUN groupadd -r -f -g ${gid} elasticappuser && useradd -o -r -l -u ${uid} -g ${gid} -ms /bin/bash elasticappuser
RUN usermod -aG sudo elasticappuser
RUN echo 'elasticappuser:elasticapp' | chpasswd
RUN mkdir -p /workspace && chown elasticappuser /workspace

ENV DEBIAN_FRONTEND=noninteractive

# Install add-apt-repository
RUN apt-get update -y \
    && apt-get install -y software-properties-common \
    && add-apt-repository -y ppa:ubuntu-toolchain-r/test

# - First set of packages are required to build and run Elasticapp.
RUN apt-get -qq update && \
    apt-get -yq --with-new-pkgs -o Dpkg::Options::="--force-confold" upgrade && \
    apt-get -y install \
    gcc-11 g++-11 \
    clang-11 clang-format-11 clang-tidy-11 \
    cmake \
    gdb \
    git \
    sudo \
    ninja-build \
    pkg-config \
    wget 

# Install ccache to cache compilations for reduced compile time
RUN apt-get update -y \
    && apt-get install -y ccache

# Install python and required libraries
COPY elastica/PythonBindings/requirements.txt /tmp/requirements.txt
COPY elastica/PythonBindings/dev_requirements.txt /tmp/dev_requirements.txt
RUN add-apt-repository universe \
    && apt-get update -y \
    && apt-get install -y python3-pip python3-setuptools python-is-python3 \
    && pip3 install --no-cache-dir --upgrade setuptools pip  \
    && pip3 --no-cache-dir install -r /tmp/requirements.txt -r /tmp/dev_requirements.txt \
    && rm /tmp/requirements.txt /tmp/dev_requirements.txt


# Install Doxygen
RUN apt-get -qq update && \
    apt-get -y install bison flex && \
    wget -nc --quiet https://github.com/doxygen/doxygen/archive/refs/tags/Release_${DOXYGEN_VERSION}.tar.gz && \
    tar xfz Release_${DOXYGEN_VERSION}.tar.gz && \
    cd doxygen-Release_${DOXYGEN_VERSION} && \
    cmake -G Ninja -DCMAKE_BUILD_TYPE=Release -B build-dir . && \
    cmake --build build-dir && \
    cmake --install build-dir && \
    apt-get -y purge bison flex && \
    apt-get -y autoremove

# Install HDF5
# Note: HDF5 CMake install has numerous bugs and inconsistencies. Test carefully.
# HDF5 overrides CMAKE_INSTALL_PREFIX by default, hence it is set
# below to ensure that HDF5 is installed into a path where it can be
# found.
RUN wget -nc --quiet https://support.hdfgroup.org/ftp/HDF5/releases/hdf5-${HDF5_SERIES}/hdf5-${HDF5_SERIES}.${HDF5_PATCH}/src/hdf5-${HDF5_SERIES}.${HDF5_PATCH}.tar.gz && \
    tar xfz hdf5-${HDF5_SERIES}.${HDF5_PATCH}.tar.gz && \
    cmake -G Ninja -DCMAKE_INSTALL_PREFIX=/usr/local -DCMAKE_BUILD_TYPE=Release -DHDF5_ENABLE_PARALLEL=OFF -DHDF5_ENABLE_Z_LIB_SUPPORT=on -B build-dir -S hdf5-${HDF5_SERIES}.${HDF5_PATCH} && \
    cmake --build build-dir && \
    cmake --install build-dir && \
    rm -rf /tmp/*

# Install required libraries
RUN git clone https://github.com/tp5uiuc/elastica_quick_setup && \
    cd elastica_quick_setup && \
    bash install.sh --dpath /workspace/third_party --ipath /workspace/third_party_installed -c g++ -j ${PARALLEL_ARG} --optional && \
    cp ~/.localrc /workspace/.localrc && \
    chown elasticappuser /workspace/third_party && \ 
    chown elasticappuser /workspace/third_party_installed && \ 
    chown elasticappuser /workspace/.localrc 

# Update ld cache to find shared libs in /usr/local/lib/
RUN ldconfig

# symbolic links for clang to create build folders.
RUN ln -s $(which clang++-11) /usr/local/bin/clang++ \
    && ln -s $(which clang-11) /usr/local/bin/clang \
    && ln -s $(which clang-format-11) /usr/local/bin/clang-format \
    && ln -s $(which clang-tidy-11) /usr/local/bin/clang-tidy

# Create entry point script
RUN echo "source /workspace/.localrc && /bin/bash "$@"" >> /workspace/.entry_point.sh && \
    chown elasticappuser /workspace/.entry_point.sh 

# Remove the apt-get cache in order to reduce image size
RUN apt-get -y clean && \
    rm -rf /tmp/*

WORKDIR /workspace
USER elasticappuser
CMD ["/bin/bash", "/workspace/.entry_point.sh"]
RUN ["/bin/bash"]

# Everything we need to run tests on CI on GitHub.
FROM dev as ci
USER root

# Install all the compilers we are going to test on CI
RUN apt-get update -y \
    && apt-get install -y g++-10 g++-12

RUN apt-get update -y \
    && apt-get install -y clang-12 clang-13

# Install minimum cmake. 
# TODO : Bump to 3.18.0 as the minimum supported after deprecating Elastica specific cmake logging functions.
# RUN wget https://github.com/Kitware/CMake/releases/download/v3.18.0/cmake-3.18.0.tar.gz \
#     && tar -xzf cmake-3.18.0.tar.gz \
#     && cd cmake-3.18.0 \
#     && CC=gcc-11 CXX=g++-11 ./bootstrap --prefix=/usr/local \
#     && make -j $PARALLEL_ARG\
#     && make install \
#     && cd .. && rm -rf cmake*

# Remove the apt-get cache in order to reduce image size
RUN apt-get -y clean && \
    rm -rf /tmp/*

WORKDIR /workspace
USER elasticappuser
CMD ["/bin/bash", "/workspace/.entry_point.sh"]
RUN ["/bin/bash"]

